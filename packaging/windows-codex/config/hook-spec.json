{
  "schema_version": 1,
  "description": "AgentMemory official session lifecycle with raw normal prompt/final-response observation and bounded exact-project curation context. Loopback local Qwen is graph-only; remote LLM processing is disabled.",
  "events": [
    {
      "name": "SessionStart",
      "timeout_seconds": 5,
      "work_budget_ms": 3000
    },
    {
      "name": "UserPromptSubmit",
      "timeout_seconds": 65,
      "work_budget_ms": 12000,
      "work_budget_max_ms": 60000,
      "additional_context_limit": 2800
    },
    {
      "name": "Stop",
      "timeout_seconds": 9,
      "work_budget_ms": 6500
    },
    {
      "name": "SessionEnd",
      "timeout_seconds": 5,
      "work_budget_ms": 3000
    }
  ]
}
