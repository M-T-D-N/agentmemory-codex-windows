+    pub async fn list_page(
+        &self,
+        index: &str,
+        offset: usize,
+        limit: usize,
+    ) -> anyhow::Result<StateListPageResult> {
+        StateListPageInput::validate_limit(limit).map_err(anyhow::Error::msg)?;
+
+        let store = self.store.read().await;
+        let values = store.get(index);
+        let total = values.map_or(0, |values| values.len());
+        if offset > total {
+            anyhow::bail!("state::list_page offset {} exceeds total {}", offset, total);
+        }
+
+        let Some(values) = values else {
+            return Ok(StateListPageResult {
+                entries: Vec::new(),
+                total,
+                next_offset: None,
+            });
+        };
+
+        let mut entries = Vec::with_capacity(limit.min(total - offset));
+        let mut serialized_entries_bytes = 0usize;
+
+        for entry_offset in offset..total {
+            if entries.len() == limit {
+                break;
+            }
+
+            let (key, value) = values
+                .get_index(entry_offset)
+                .expect("entry offset is within the IndexMap length");
+            let separator_bytes = if entries.is_empty() { 0 } else { 1 };
+            let remaining_bytes = STATE_LIST_PAGE_MAX_JSON_BYTES
+                .saturating_sub(serialized_entries_bytes)
+                .saturating_sub(separator_bytes);
+            let entry_bytes =
+                measure_json_bytes(&BorrowedStateListPageEntry { key, value }, remaining_bytes)?;
+
+            let Some(entry_bytes) = entry_bytes else {
+                if entries.is_empty() {
+                    anyhow::bail!(
+                        "state::list_page entry at offset {} cannot fit within the {}-byte result limit",
+                        entry_offset,
+                        STATE_LIST_PAGE_MAX_JSON_BYTES
+                    );
+                }
+                break;
+            };
+
+            serialized_entries_bytes = serialized_entries_bytes
+                .saturating_add(separator_bytes)
+                .saturating_add(entry_bytes);
+            entries.push(StateListPageEntry {
+                key: key.clone(),
+                value: value.clone(),
+            });
+        }
+
+        loop {
+            let next_offset = offset + entries.len();
+            let next_offset = (next_offset < total).then_some(next_offset);
+            let page = BorrowedStateListPageResult {
+                entries: &entries,
+                total,
+                next_offset,
+            };
+
+            if measure_json_bytes(&page, STATE_LIST_PAGE_MAX_JSON_BYTES)?.is_some() {
+                return Ok(StateListPageResult {
+                    entries,
+                    total,
+                    next_offset,
+                });
+            }
+
+            entries.pop();
+            if entries.is_empty() && offset < total {
+                anyhow::bail!(
+                    "state::list_page entry at offset {} cannot fit within the {}-byte result limit",
+                    offset,
+                    STATE_LIST_PAGE_MAX_JSON_BYTES
+                );
+            }
+        }
+    }
