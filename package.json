{
  "name": "@agentmemory/agentmemory",
  "version": "0.9.29",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "description": "Independent Windows-native AgentMemory downstream for OpenAI Codex Desktop and CLI",
  "agentmemoryDownstream": {
    "displayName": "AgentMemory for Codex on Windows",
    "version": "0.1.0-preview.2",
    "repositoryName": "agentmemory-codex-windows",
    "supportedHostProfile": "windows-codex",
    "agentmemoryCompatibilityVersion": "0.9.29"
  },
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./dist/standalone.mjs": "./dist/standalone.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "agentmemory": "dist/cli.mjs"
  },
  "scripts": {
    "build": "tsdown && node scripts/copy-build-assets.mjs",
    "dev": "tsx src/index.ts",
    "start": "node dist/cli.mjs",
    "migrate": "node dist/functions/migrate.js",
    "test": "vitest run --exclude test/integration.test.ts --exclude packaging/windows-codex/tests/**/*.test.mjs",
    "test:watch": "vitest --exclude test/integration.test.ts --exclude packaging/windows-codex/tests/**/*.test.mjs",
    "test:integration": "vitest run test/integration.test.ts",
    "test:all": "vitest run",
    "typecheck": "tsc --noEmit",
    "skills:gen": "tsx scripts/skills/generate.ts",
    "skills:check": "tsx scripts/skills/generate.ts --check && tsx scripts/skills/check.ts",
    "bench:load": "node --import tsx benchmark/load-100k.ts",
    "eval:longmemeval": "tsx eval/runner/longmemeval.ts",
    "eval:coding-life": "tsx eval/runner/coding-life.ts"
  },
  "keywords": [
    "ai",
    "agent",
    "memory",
    "persistent",
    "iii-engine",
    "claude-code",
    "coding-agent",
    "context",
    "observation",
    "windows",
    "codex"
  ],
  "files": [
    "dist/",
    "plugin/",
    "integrations/pi/",
    "iii-config.yaml",
    "iii-config.docker.yaml",
    "docker-compose.yml",
    ".env.example",
    "LICENSE",
    "README.md",
    "AGENTS.md"
  ],
  "author": "M-T-D-N <M-T-D-N@users.noreply.github.com>",
  "contributors": [
    "Rohit Ghumare and AgentMemory contributors (upstream)"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/M-T-D-N/agentmemory-codex-windows"
  },
  "homepage": "https://github.com/M-T-D-N/agentmemory-codex-windows#readme",
  "bugs": {
    "url": "https://github.com/M-T-D-N/agentmemory-codex-windows/issues"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.142",
    "@anthropic-ai/sdk": "^0.100.1",
    "@clack/prompts": "^1.2.0",
    "dotenv": "^17.4.2",
    "iii-sdk": "0.11.2",
    "picocolors": "^1.1.1",
    "zod": "^4.0.0"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@node-rs/jieba": "^2.0.1",
    "tiny-segmenter": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsdown": "^0.21.10",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "qs": "^6.15.2",
    "ws": "^8.21.0",
    "protobufjs": "^7.5.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
